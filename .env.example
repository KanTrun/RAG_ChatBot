# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
DATABASE_SYNC_URL=postgresql://rag:rag@localhost:5432/ragdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend (supports both JSON list and comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEBUG=true
LOG_LEVEL=info
FAST_MODE=false

# Embedding (Local-first via Ollama)
EMBEDDING_PROVIDER=ollama
# Options: ollama (local: mxbai-embed-large or bge-m3), bge-m3 (self-hosted), openai (API)
BGE_MODEL_NAME=BAAI/bge-m3
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4

# LLM (Local-first via Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# Optional smaller/faster CPU model: LLM_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=4096
FIRST_TOKEN_TIMEOUT_SECONDS=120
STREAM_CHUNK_TIMEOUT_SECONDS=60
OLLAMA_WARMUP_ON_STARTUP=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Retrieval & Reranker
ENABLE_BM25=true
HNSW_EF_SEARCH=64
RERANKER_PROVIDER=none
# Options: none (fast CPU lexical/structural reranker), bge-reranker (Cross-Encoder, requires GPU/high CPU)
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Rate Limiting (requests per minute)
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=100

# Auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Admin

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3001

# Chunking & Ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=51
INGESTION_DISPATCH_MODE=auto
