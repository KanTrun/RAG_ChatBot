# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
DATABASE_SYNC_URL=postgresql://rag:rag@localhost:5432/ragdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
DEBUG=true
LOG_LEVEL=info

# Embedding
EMBEDDING_PROVIDER=ollama
# Options: ollama (local), bge-m3 (self-hosted, requires GPU), openai (API)
BGE_MODEL_NAME=BAAI/bge-m3
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Reranker
RERANKER_PROVIDER=none
# Options: bge-reranker (self-hosted), none (skip reranking in dev)
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Admin

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3001

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=51
INGESTION_DISPATCH_MODE=auto
