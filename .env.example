# Database
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
DATABASE_SYNC_URL=postgresql://rag:rag@localhost:5432/ragdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=true
LOG_LEVEL=info

# Embedding (Local-first via Ollama)
EMBEDDING_PROVIDER=ollama
# Options: ollama (local), bge-m3 (self-hosted, requires GPU), openai (API)
BGE_MODEL_NAME=BAAI/bge-m3
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# LLM (Local-first via Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
FIRST_TOKEN_TIMEOUT_SECONDS=120
STREAM_CHUNK_TIMEOUT_SECONDS=60
OLLAMA_WARMUP_ON_STARTUP=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Retrieval & Reranker
ENABLE_BM25=true
RERANKER_PROVIDER=none
# Options: bge-reranker (self-hosted), none (lexical/structural reranker for CPU)
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Rate Limiting (requests per minute)
RATE_LIMIT_CHAT=30
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=100

# Auth
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Admin

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3001

# Chunking & Ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=51
INGESTION_DISPATCH_MODE=auto
